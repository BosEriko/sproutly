rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null
        && request.auth.token.sproutly == true;
    }

    match /apps/sproutly/bottles/{bottleId} {
      allow read: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'room';
      allow update: if isAllowed()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.madeAt == resource.data.madeAt
        && resource.data.status != 'done';
      allow delete: if false;
    }

    match /apps/sproutly/profile/baby {
      allow read: if isAllowed();
      allow write: if isAllowed()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
    }
  }
}
