rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isParent() {
      return request.auth != null
        && request.auth.uid in ['REPLACE_WITH_PARENT_1_UID', 'REPLACE_WITH_PARENT_2_UID'];
    }

    match /bottles/{bottleId} {
      allow read: if isParent();
      allow create: if isParent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'room';
      allow update: if isParent()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.madeAt == resource.data.madeAt
        && resource.data.status != 'done';
      allow delete: if false;
    }
  }
}
